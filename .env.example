### Frontend environment example
# Copy this to `.env` (which is ignored) and set your values.
# `VITE_` prefixed vars are exposed to the frontend build.

# Base API URL the frontend should call. Example for local dev:
VITE_API_BASE=https://api.mirabellier.com/v1

# Public Cloudflare Turnstile site key.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Public site URL used by sitemap generation and SEO helpers.
WEBSITE_BASE=https://mirabellier.com
